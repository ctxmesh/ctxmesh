# Dockerfile.statelayer-proxy — the control-plane state-layer proxy (M51, ADR 0050).
#
# Builds only the statelayer-proxy binary (cmd/statelayer-proxy) as a distroless/
# static image. It runs as a control-plane Deployment holding the Valkey credential
# and enforces per-tenant/agent memory scope SERVER-SIDE from the verified
# run-capability token — agent workloads hold no credential and can't name another
# tenant's key.

FROM --platform=$BUILDPLATFORM golang:1.26 AS builder
ARG TARGETOS
ARG TARGETARCH

WORKDIR /workspace
COPY go.mod go.sum ./
# Retry: proxy.golang.org drops HTTP/2 streams under load, and it failed two different required
# CI jobs 24 minutes apart on 2026-09-11 (sum.golang.org in lint, proxy.golang.org here), neither
# related to the change under test. `exit 0` on success and an explicit `exit 1` after exhaustion —
# a retry loop that falls through to success is the version of this fix that hides the failure.
RUN set -e; \
    for i in 1 2 3 4 5; do \
      if go mod download; then exit 0; fi; \
      echo "go mod download failed (attempt $i/5) — retrying" >&2; \
      sleep $((i * 5)); \
    done; \
    echo "go mod download failed after 5 attempts" >&2; \
    exit 1

COPY . .
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} \
    go build -a -o statelayer-proxy ./cmd/statelayer-proxy

FROM gcr.io/distroless/static:nonroot
COPY --from=builder /workspace/statelayer-proxy /statelayer-proxy
USER 65532:65532
ENTRYPOINT ["/statelayer-proxy"]
