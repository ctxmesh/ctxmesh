# Dockerfile.replay — the replay-serve image (ADR 0071 §3a).
#
# Builds the ctxmesh CLI (cmd/ctxmesh) as a distroless/static image whose
# ENTRYPOINT is the CLI, so `docker run … replay-serve <fixture>` serves the both-channel
# replay mock. `ctxmesh dev --replay` swaps the mock LiteLLM gateway for a container
# from this image (under the same `gateway` service name + port), so the re-run agent hits
# the recorded model + tool I/O deterministically with zero cluster deps.
#
# This mirrors Dockerfile.launcher exactly (same base, same build flags) — the only delta is
# the built package (cmd/ctxmesh instead of cmd/launcher). No existing image ships the
# ctxmesh CLI, so this is a new but pattern-consistent per-binary image.
#
# The image tag is pinned to the CLI version (ctxmesh-replay:<version>); `dev --replay`
# checks /replay/version at startup and fails fast on a mismatch.

FROM golang:1.26 AS builder
ARG TARGETOS
ARG TARGETARCH
# REPLAY_VERSION stamps the CLI/replay version reported at /replay/version. It MUST match the tag
# (ctxmesh-replay:<version>) so `dev --replay`'s parity check passes; defaults to the CLI's
# built-in default (m78-smoke), the Makefile passes REPLAY_TAG.
ARG REPLAY_VERSION=m78-smoke

WORKDIR /workspace
COPY go.mod go.sum ./
# Retry: proxy.golang.org drops HTTP/2 streams under load, and it failed two different required
# CI jobs 24 minutes apart on 2026-09-11 (sum.golang.org in lint, proxy.golang.org here), neither
# related to the change under test. `exit 0` on success and an explicit `exit 1` after exhaustion —
# a retry loop that falls through to success is the version of this fix that hides the failure.
RUN set -e; \
    for i in 1 2 3 4 5; do \
      if go mod download; then exit 0; fi; \
      echo "go mod download failed (attempt $i/5) — retrying" >&2; \
      sleep $((i * 5)); \
    done; \
    echo "go mod download failed after 5 attempts" >&2; \
    exit 1

COPY . .
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} \
    go build -a -ldflags "-X github.com/ctxmesh/ctxmesh/internal/replay.Version=${REPLAY_VERSION} -X main.devVersion=${REPLAY_VERSION}" \
    -o ctxmesh ./cmd/ctxmesh

FROM gcr.io/distroless/static:nonroot
COPY --from=builder /workspace/ctxmesh /ctxmesh
USER 65532:65532
ENTRYPOINT ["/ctxmesh"]
