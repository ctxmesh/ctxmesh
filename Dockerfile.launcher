# Dockerfile.launcher — standalone launcher image.
#
# Builds only the launcher binary (cmd/launcher) as a distroless/static image.
# This image is an ENTRYPOINT layer: users compose it by setting AGENT_ENTRYPOINT
# to the path of their agent binary inside their own image.
#
# Usage example (in a downstream Dockerfile):
#   COPY --from=launcher:latest /launcher /launcher
#   COPY myapp /myapp
#   ENV AGENT_ENTRYPOINT=/myapp
#   ENTRYPOINT ["/launcher"]
#
# See examples/echo-agent/Dockerfile for the canonical combined pattern.

FROM golang:1.26 AS builder
ARG TARGETOS
ARG TARGETARCH

WORKDIR /workspace
COPY go.mod go.sum ./
# Retry: proxy.golang.org drops HTTP/2 streams under load, and it failed two different required
# CI jobs 24 minutes apart on 2026-09-11 (sum.golang.org in lint, proxy.golang.org here), neither
# related to the change under test. `exit 0` on success and an explicit `exit 1` after exhaustion —
# a retry loop that falls through to success is the version of this fix that hides the failure.
RUN set -e; \
    for i in 1 2 3 4 5; do \
      if go mod download; then exit 0; fi; \
      echo "go mod download failed (attempt $i/5) — retrying" >&2; \
      sleep $((i * 5)); \
    done; \
    echo "go mod download failed after 5 attempts" >&2; \
    exit 1

COPY . .
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} \
    go build -a -o launcher ./cmd/launcher

FROM gcr.io/distroless/static:nonroot
COPY --from=builder /workspace/launcher /launcher
USER 65532:65532
ENTRYPOINT ["/launcher"]
