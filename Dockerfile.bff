# BFF image: the Go Backend-for-Frontend serving the STATIC Vite SPA build.
# Node is used at BUILD TIME ONLY (ADR 0010) — the final image is a distroless
# static Go binary plus the compiled dist/ assets. No Node runtime is shipped.
#
# Node is pinned by ui/.nvmrc; here the CI/image build pins the SAME major via
# the node base image tag. pnpm is corepack-activated and installs from the
# committed lockfile (--frozen-lockfile) so the image build is deterministic.

# --- Stage 1: build the SPA (Node, build-time only) -------------------------
FROM node:22-slim AS ui
WORKDIR /ui
# corepack ships with node:22; activate the pnpm pinned in package.json.
RUN corepack enable
# Cache deps on the lockfile before copying the source.
COPY ui/package.json ui/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY ui/ ./
RUN pnpm build

# --- Stage 2: build the Go BFF binary ---------------------------------------
FROM golang:1.26 AS builder
ARG TARGETOS
ARG TARGETARCH
WORKDIR /workspace
COPY go.mod go.mod
COPY go.sum go.sum
# Retry: proxy.golang.org drops HTTP/2 streams under load, and it failed two different required
# CI jobs 24 minutes apart on 2026-09-11 (sum.golang.org in lint, proxy.golang.org here), neither
# related to the change under test. `exit 0` on success and an explicit `exit 1` after exhaustion —
# a retry loop that falls through to success is the version of this fix that hides the failure.
RUN set -e; \
    for i in 1 2 3 4 5; do \
      if go mod download; then exit 0; fi; \
      echo "go mod download failed (attempt $i/5) — retrying" >&2; \
      sleep $((i * 5)); \
    done; \
    echo "go mod download failed after 5 attempts" >&2; \
    exit 1
COPY . .
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -a -o bff ./cmd/bff

# --- Stage 3: minimal runtime (NO Node) -------------------------------------
FROM gcr.io/distroless/static:nonroot
WORKDIR /
COPY --from=builder /workspace/bff /bff
COPY --from=ui /ui/dist /ui/dist
USER 65532:65532
EXPOSE 9090
# --static-dir points at the compiled SPA; the BFF serves it + /api behind auth.
ENTRYPOINT ["/bff", "--static-dir", "/ui/dist"]
