}

fn header(name: &str, value: &str) -> tiny_http::Header {
    tiny_http::Header::from_bytes(name.as_bytes(), value.as_bytes()).expect("a valid header")
}

fn text_response(status: u16, text: &str) -> tiny_http::Response<std::io::Cursor<Vec<u8>>> {
    tiny_http::Response::from_data(text.as_bytes().to_vec())
        .with_status_code(status)
        .with_header(header("Content-Type", "text/plain; charset=utf-8"))
}

fn request_violations(route: &Value, r: &Received) -> Vec<String> {
    let mut out = Vec::new();
    let request = &route["request"];
    let served = str_of(&route["servedMethod"]);
    if str_of(&route["method"]) == "ANY" && r.method != served {
        out.push(format!("the route serves {served}, not {}", r.method));
    }
    let required: BTreeMap<&String, &Value> = request["headers"]
        .as_object()
        .map(|m| m.iter().collect())
        .unwrap_or_default();
    for (name, h) in required {
        if h["required"].as_bool().unwrap_or(false)
            && !r.header(name).is_some_and(|v| !v.is_empty())
        {
            out.push(format!("missing required header {name}"));
        }
    }
    let mut keys: Vec<&String> = r.query.iter().map(|(k, _)| k).collect();
    keys.sort();
    keys.dedup();
    for k in keys {
        let schema = &request["query"][k.as_str()];
        if schema.is_null() {
            out.push(format!("query parameter {k} is not in the contract"));
            continue;
        }
        let v = r
            .query
            .iter()
            .find(|(qk, _)| qk == k)
            .map(|(_, v)| v.clone())
            .unwrap_or_default();
        out.extend(validate(
            schema,
            &Value::String(v),
            &format!("query parameter {k}"),
        ));
    }
    let want: Vec<&str> = str_of(&route["path"])
        .trim_matches('/')
        .split('/')
        .collect();
    let got: Vec<&str> = r.path.trim_matches('/').split('/').collect();
    for (i, w) in want.iter().enumerate() {
        if let (Some(g), true) = (got.get(i), w.starts_with('{')) {
            let name = w.trim_matches(|c| c == '{' || c == '}');
            let schema = &request["params"][name];
            if !schema.is_null() {
                out.extend(validate(
                    schema,
                    &Value::String((*g).to_string()),
                    &format!("path parameter {name}"),
                ));
            }
        }
    }
    let body_schema = &request["body"];
    let takes_body = request.get("body").is_some();
    if !takes_body && !r.body.is_empty() {
        out.push("the route takes no body".into());
    } else if takes_body && r.body.is_empty() {
        if !request["optionalBody"].as_bool().unwrap_or(false) {
            out.push("the route requires a body".into());
        }
    } else if takes_body {
        match serde_json::from_slice::<Value>(&r.body) {
            Ok(v) => out.extend(validate(body_schema, &v, "body")),
            Err(e) => out.push(format!("body is not JSON: {e}")),
        }
    }
    out
}

fn path_matches(pattern: &str, path: &str) -> bool {
    let want: Vec<&str> = pattern.trim_matches('/').split('/').collect();
    let got: Vec<&str> = path.trim_matches('/').split('/').collect();
    want.len() == got.len()
        && want.iter().zip(&got).all(|(w, g)| {
            if w.starts_with('{') {
                !g.is_empty()
            } else {
                w == g
            }
        })
}

fn is_json(content_type: &str) -> bool {
    content_type.split(';').next().unwrap_or_default().trim() == "application/json"
}

fn percent_decode(s: &str, plus_is_space: bool) -> String {
    let bytes = s.as_bytes();
    let hex = |b: u8| (b as char).to_digit(16).map(|d| d as u8);
    let mut out = Vec::with_capacity(bytes.len());
    let mut i = 0;
    while i < bytes.len() {
        match bytes[i] {
            b'%' if i + 2 < bytes.len() => {
                if let (Some(hi), Some(lo)) = (hex(bytes[i + 1]), hex(bytes[i + 2])) {
                    out.push(hi * 16 + lo);
                    i += 3;
                    continue;
                }
                out.push(b'%');
            }
            b'+' if plus_is_space => out.push(b' '),
            b => out.push(b),
        }
        i += 1;
    }
    String::from_utf8_lossy(&out).into_owned()
}

/// Checks `v` against the contract's JSON Schema subset: type, properties, required,
/// additionalProperties, items, enum, minLength, maxLength.
fn validate(schema: &Value, v: &Value, at: &str) -> Vec<String> {
    let Some(s) = schema.as_object() else {
        return vec![format!("{at}: malformed schema")];
    };
    if let Some(t) = s.get("type") {
        if !type_matches(t, v) {
            return vec![format!("{at}: is {}, want {t}", type_of(v))];
        }
    }
    let mut out = Vec::new();
    if let Some(choices) = s.get("enum").and_then(Value::as_array) {
        if !choices.contains(v) {
            out.push(format!(
                "{at}: {v} is not one of {}",
                Value::from(choices.clone())
            ));
        }
    }
    if let Some(text) = v.as_str() {
        let n = text.chars().count() as u64;
        if let Some(min) = s.get("minLength").and_then(Value::as_u64) {
            if n < min {
                out.push(format!("{at}: {text:?} is shorter than {min}"));
            }
        }
        if let Some(max) = s.get("maxLength").and_then(Value::as_u64) {
            if n > max {
                out.push(format!("{at}: {text:?} is longer than {max}"));
            }
        }
    }
    if let Some(obj) = v.as_object() {
        for name in s
            .get("required")
            .and_then(Value::as_array)
            .into_iter()
            .flatten()
        {
            let name = str_of(name);
            if !name.is_empty() && !obj.contains_key(name) {
                out.push(format!("{at}: missing required property {name:?}"));
            }
        }
        let props = s.get("properties").and_then(Value::as_object);
        let mut keys: Vec<&String> = obj.keys().collect();
        keys.sort();
        for k in keys {
            if let Some(ps) = props.and_then(|p| p.get(k)) {
                out.extend(validate(ps, &obj[k], &format!("{at}.{k}")));
                continue;
            }
            match s.get("additionalProperties") {
                Some(Value::Bool(false)) => {
                    out.push(format!("{at}: property {k:?} is not in the contract"))
                }
                Some(ap @ Value::Object(_)) => {
                    out.extend(validate(ap, &obj[k], &format!("{at}.{k}")))
                }
                _ => {}
            }
        }
    }
    if let (Some(arr), Some(items)) = (v.as_array(), s.get("items")) {
        for (i, e) in arr.iter().enumerate() {
            out.extend(validate(items, e, &format!("{at}[{i}]")));
        }
    }
    out
}

fn type_matches(t: &Value, v: &Value) -> bool {
    match t {
        Value::String(name) => is_type(name, v),
        Value::Array(names) => names.iter().any(|n| is_type(str_of(n), v)),
        _ => false,
    }
}

fn is_type(t: &str, v: &Value) -> bool {
    match t {
        "integer" => v
            .as_f64()
            .is_some_and(|f| v.is_i64() || v.is_u64() || f.fract() == 0.0),
        "number" => v.is_number(),
        _ => type_of(v) == t,
    }
}

fn type_of(v: &Value) -> &'static str {
    match v {
        Value::Null => "null",
        Value::Bool(_) => "boolean",
        Value::Number(_) => "number",
        Value::String(_) => "string",
        Value::Array(_) => "array",
        Value::Object(_) => "object",
    }
}

