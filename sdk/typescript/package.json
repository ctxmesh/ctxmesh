{
  "name": "ctxmesh",
  "version": "0.1.0-beta.1",
  "license": "Apache-2.0",
  "description": "The ctxmesh TypeScript SDK \u2014 typed access to the ctxmesh launcher localhost plane (memory, tools, mesh calls, feedback), at parity with the Python SDK.",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/esm/testing.d.ts",
        "default": "./dist/esm/testing.js"
      },
      "require": {
        "types": "./dist/cjs/testing.d.ts",
        "default": "./dist/cjs/testing.js"
      }
    }
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b && node ./scripts/finalize-cjs.mjs",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@arizeai/openinference-semantic-conventions": "^2.7.0",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "ajv": "^8"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": false
    }
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/node": "22.10.5",
    "eslint": "9.17.0",
    "globals": "15.14.0",
    "typescript": "5.7.2",
    "typescript-eslint": "8.19.1",
    "vitest": "2.1.8",
    "@opentelemetry/api": "1.9.1"
  },
  "sideEffects": false,
  "keywords": [
    "ctxmesh",
    "llm",
    "agents",
    "kubernetes",
    "observability",
    "sdk"
  ],
  "homepage": "https://ctxmesh.github.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ctxmesh/ctxmesh.git",
    "directory": "sdk/typescript"
  },
  "bugs": {
    "url": "https://github.com/ctxmesh/ctxmesh/issues"
  },
  "author": "ctxmesh",
  "publishConfig": {
    "access": "public"
  }
}
