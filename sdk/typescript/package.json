{
  "name": "ctxmesh",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "The ctxmesh TypeScript SDK \u2014 typed sugar over the ctxmesh launcher localhost plane, at parity with the Python SDK (sdk/python). Vendored into the base-node agent image, not published to npm (ADR 0070).",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b && node ./scripts/finalize-cjs.mjs",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@arizeai/openinference-semantic-conventions": "^2.7.0",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "ajv": "^8"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": false
    }
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/node": "22.10.5",
    "eslint": "9.17.0",
    "globals": "15.14.0",
    "typescript": "5.7.2",
    "typescript-eslint": "8.19.1",
    "vitest": "2.1.8",
    "@opentelemetry/api": "1.9.1"
  },
  "sideEffects": false
}
