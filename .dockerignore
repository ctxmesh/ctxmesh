# More info: https://docs.docker.com/engine/reference/builder/#dockerignore-file
# Ignore everything by default and re-include only needed files
**

# Re-include Go source files (but not *_test.go)
!**/*.go
**/*_test.go

# Re-include Go module files
!go.mod
!go.sum

# Re-include the control-plane goose migrations (ADR 0042, m40): internal/controlplane embeds
# migrations/*.sql via //go:embed, so the .sql files must be in the build context or the build fails.
!internal/controlplane/migrations/**

# Re-include the embedded recipe gallery (m72.4, ADR 0066 D4): internal/bff/recipes.go embeds
# recipes/*.yaml via //go:embed, so the .yaml files must be in the build context or the build fails.
!internal/bff/recipes/**

# Re-include the embedded WorkflowSpec JSON-Schema (m83.2, L6): internal/bff/workflows_handler.go
# embeds workflow_spec_schema.json via //go:embed, so it must be in the build context or the bff
# image build fails ("pattern workflow_spec_schema.json: no matching files found"). Host `go build`
# (tier0) + helm-verify don't build the image, so this only surfaces in the docker build.
!internal/bff/workflow_spec_schema.json

# Re-include the Vite SPA source so Dockerfile.bff can build the static UI
# (m12.8a: the BFF image = build-time Node build of ui/ + Go binary, NO Node
# runtime). Deps + build output are produced INSIDE the image from the committed
# lockfile, so node_modules/ and dist/ are kept OUT of the build context.
!ui/**
ui/node_modules/**
ui/dist/**

# Re-include Python base image assets (m3.3: base-python)
!images/base-python/requirements.txt
!images/base-python/sitecustomize.py

# Re-include the ctxmesh SDK source so base-python/Dockerfile can bundle it
# (m10.4: pip install sdk/python/ during the base image build).
!sdk/python/pyproject.toml
!sdk/python/README.md
!sdk/python/src/
!sdk/python/src/**

# Re-include the ctxmesh TypeScript SDK source so images/base-node/Dockerfile can
# `pnpm install --frozen-lockfile && pnpm build && pnpm pack` it during the base-node
# image build (m77.6, ADR 0070 §3). Everything the in-image build+pack needs — the
# manifest+lockfile, all tsconfigs, the .nvmrc, the build script, src, the README (in
# package.json "files"), and the lint/test configs pnpm may touch. node_modules/ and
# dist/ are deliberately NOT re-included — they are produced INSIDE the image.
!sdk/typescript/package.json
!sdk/typescript/pnpm-lock.yaml
!sdk/typescript/tsconfig*.json
!sdk/typescript/.nvmrc
!sdk/typescript/README.md
!sdk/typescript/eslint.config.js
!sdk/typescript/vitest.config.ts
!sdk/typescript/scripts/
!sdk/typescript/scripts/**
!sdk/typescript/src/
!sdk/typescript/src/**

# Re-include LangChain example agent assets (m3.4: langchain-agent)
!examples/langchain-agent/requirements.txt
!examples/langchain-agent/agent.py

# Re-include batch-agent example assets (m7.7: batch-agent, job execution model)
!examples/batch-agent/agent.py

# Re-include sdk-custom-agent example assets (m10.4)
!examples/sdk-custom-agent/agent.py

# Re-include managed-agent runtime image assets (m14.3: the config-driven
# managed agent — a thin entrypoint over the SDK's run_managed_loop, ADR 0013)
!images/managed-agent/entrypoint.py
